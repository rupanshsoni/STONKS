# STONKS desk worker — copy to .env and fill in. NEVER commit .env.
ALPACA_MODE=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# LLMs — OpenRouter is the PRIMARY surface (GLM 5.2 free + MiniMax M3 free,
# verified live). Gemini/OpenAI/Featherless are optional fallbacks.
OPENROUTER_GLM_KEY=
OPENROUTER_MINIMAX_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
FEATHERLESS_API_KEY=
# optional
TICK_SECONDS=1800
CORS_ALLOW_ORIGIN=*
DESK_PAUSED=false
STONKS_TEST=false
